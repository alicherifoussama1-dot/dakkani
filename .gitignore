# dependencies
# NOTE: the leading slash only matched the ROOT node_modules. The mobile app
# lives in apps/mobile, so its 41k dependency files were NOT ignored.
/node_modules
**/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# ── React Native / Expo app (apps/mobile) ──
**/.expo/
**/.expo-shared/
apps/*/dist/
apps/*/android/
apps/*/ios/
*.jks
*.keystore
# Firebase CLIENT config is safe to commit (no private key) and EAS needs it
# in the build context, so it is deliberately NOT ignored here.

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pwa
/public/workbox-*.js
/public/sw.js
/public/worker-*.js
/public/fallback-*.js

.vercel
build.log

# landing-v6 capture artifacts
design/landing-v6/.chrome-tmp/
design/landing-v6/shots/
design/landing-v6/_seg-*.png
