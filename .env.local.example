# ============================================================
# COMMERCO — Environment Variables
# Copy to .env.local and fill in your values
# ============================================================

# ── Supabase (Required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App URL ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://dakkani.vercel.app

# ── AI (Gemini) ──────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
# Text model — gemini-2.5-flash works on the free tier.
# With billing enabled you can upgrade to gemini-3-pro-preview.
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Backup used automatically when the main model is overloaded
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.1-flash-lite
# Image model — ALL image models require billing. Without it the Photo
# Studio gracefully falls back to the original product photo.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── Delivery Integrations ────────────────────────────────────
YALIDINE_API_ID=your-yalidine-api-id
YALIDINE_API_TOKEN=your-yalidine-token
ZREXPRESS_API_TOKEN=your-zrexpress-token
MAYSTRO_API_KEY=your-maystro-key

# ── Payment (Chargily / Slick) ───────────────────────────────
CHARGILY_API_KEY=your-chargily-key
CHARGILY_SECRET=your-chargily-secret

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=your-resend-key
EMAIL_FROM=noreply@commerco.dz

# ── SMS (Twilio) ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# ── WhatsApp (Green API) ─────────────────────────────────────
WHATSAPP_INSTANCE_ID=your-instance-id
WHATSAPP_API_TOKEN=your-api-token

# ── Build ────────────────────────────────────────────────────
NODE_OPTIONS=--max-old-space-size=4096
DISABLE_PWA=true

# ── Google Sheets (order routing) ────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials →
# OAuth client (Web). Redirect URI: {APP_URL}/api/google/oauth/callback
# Enable "Google Sheets API". Server-side only — never NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# ── AI Image Processing ──────────────────────────────────────
REMOVEBG_API_KEY=your-removebg-key
ANTHROPIC_API_KEY=your-anthropic-key

# ── ZR Express Delivery ──────────────────────────────────────
ZREXPRESS_TOKEN=your-zrexpress-token
ZREXPRESS_KEY=your-zrexpress-key

# ── Storage Bucket ────────────────────────────────────────────
NEXT_PUBLIC_STORAGE_BUCKET=dakkani-uploads

# ── Meta / TikTok CAPI ───────────────────────────────────────
META_ACCESS_TOKEN=your-meta-capi-token
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token

# ── Security ─────────────────────────────────────────────────
CRON_SECRET=your-random-secret-for-cron-jobs
