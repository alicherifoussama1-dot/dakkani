# ============================================================
# DAKKANI — Environment Variables
# Copy to .env.local and fill in your values
# ============================================================

# ── Supabase (Required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App URL ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://dakkani.vercel.app

# ── AI (Gemini) ──────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
# Text model (needs billing for gemini-3-pro-preview; gemini-3.5-flash works free)
GEMINI_TEXT_MODEL=gemini-3-pro-preview
# Image model (needs billing; gemini-2.5-flash-image works free)
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# ── Delivery Integrations ────────────────────────────────────
YALIDINE_API_ID=your-yalidine-api-id
YALIDINE_API_TOKEN=your-yalidine-token
ZREXPRESS_API_TOKEN=your-zrexpress-token
MAYSTRO_API_KEY=your-maystro-key

# ── Payment (Chargily / Slick) ───────────────────────────────
CHARGILY_API_KEY=your-chargily-key
CHARGILY_SECRET=your-chargily-secret

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=your-resend-key
EMAIL_FROM=noreply@dakkani.dz

# ── SMS (Twilio) ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# ── WhatsApp (Green API) ─────────────────────────────────────
WHATSAPP_INSTANCE_ID=your-instance-id
WHATSAPP_API_TOKEN=your-api-token

# ── Build ────────────────────────────────────────────────────
NODE_OPTIONS=--max-old-space-size=4096
DISABLE_PWA=true

# ── AI Image Processing ──────────────────────────────────────
REMOVEBG_API_KEY=your-removebg-key
ANTHROPIC_API_KEY=your-anthropic-key

# ── ZR Express Delivery ──────────────────────────────────────
ZREXPRESS_TOKEN=your-zrexpress-token
ZREXPRESS_KEY=your-zrexpress-key

# ── Storage Bucket ────────────────────────────────────────────
NEXT_PUBLIC_STORAGE_BUCKET=dakkani-uploads

# ── Meta / TikTok CAPI ───────────────────────────────────────
META_ACCESS_TOKEN=your-meta-capi-token
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token

# ── Security ─────────────────────────────────────────────────
CRON_SECRET=your-random-secret-for-cron-jobs
