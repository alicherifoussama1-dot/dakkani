# ============================================================
# COMMERCO MOBILE — build-time environment
#
# EXPO_PUBLIC_* values are INLINED INTO THE BUNDLE at build time.
# They are readable by anyone who unpacks the APK/IPA, so only ever put
# public values here. Never the service-role key.
#
# Copy to `.env` and fill in before running `expo start` or `eas build`.
# For EAS builds these must also be set on the build profile:
#   eas env:create --name EXPO_PUBLIC_SUPABASE_URL --value "..." --environment production
# ============================================================

# Supabase project URL — Dashboard → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase ANON key (public, RLS-protected). NOT the service_role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Backend origin serving /api/mobile/v1/*. Defaults to the production host
# when unset; point it at a tunnel/LAN IP for local development.
EXPO_PUBLIC_API_URL=https://dakkani.vercel.app
