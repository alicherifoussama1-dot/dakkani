# ============================================================
# DAKKANI — Complete Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-store.vercel.app
NEXT_PUBLIC_APP_NAME=دكاني

# ── Meta (Facebook/Instagram) ─────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
META_ACCESS_TOKEN=EAAxxxxxxxxx...    # System User token
META_APP_SECRET=abc123...
# META_TEST_EVENT_CODE=TEST12345      # Uncomment for testing

# ── TikTok ────────────────────────────────────────────────
NEXT_PUBLIC_TIKTOK_PIXEL_ID=CXXXXXXXXXXXXXXX
TIKTOK_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxx...

# ── Delivery Partners ─────────────────────────────────────
DEFAULT_DELIVERY_PROVIDER=yalidine
YALIDINE_FROM_WILAYA=16              # 16 = Alger

# Yalidine
YALIDINE_API_ID=your_api_id
YALIDINE_API_TOKEN=your_api_token

# ZR Express (procolis.com)
ZREXPRESS_TOKEN=your_token
ZREXPRESS_KEY=your_key

# Maystro
MAYSTRO_TOKEN=your_bearer_token
MAYSTRO_STORE_ID=your_store_id

# ── Chargily Pay (CIB + Edahabia) ────────────────────────
CHARGILY_API_KEY=your_public_key
CHARGILY_SECRET_KEY=your_secret_key
NEXT_PUBLIC_CHARGILY_MODE=test       # test | live

# ── Google Gemini AI ──────────────────────────────────────
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXX

# ── Anthropic Claude ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXX

# ── Twilio SMS ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+12025551234

# ── WhatsApp Business (Meta Cloud API) ───────────────────
WHATSAPP_BUSINESS_TOKEN=EAAxxxxxxxxx...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_PHONE_ID=123456789012345     # same as above

# ── Image Processing ──────────────────────────────────────
REMOVE_BG_API_KEY=your_removebg_key
REMOVEBG_API_KEY=your_removebg_key   # alias

# ── Google OAuth (Sheets integration) ────────────────────
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-XXXXXXXXX

# ── Storage ───────────────────────────────────────────────
NEXT_PUBLIC_STORAGE_BUCKET=dakkani-uploads

# ── Build ─────────────────────────────────────────────────
DISABLE_PWA=false                    # set true to skip PWA during dev
