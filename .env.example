# ============================================================
# DAKKANI — Complete Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://dakkani.vercel.app
NEXT_PUBLIC_APP_NAME=دكاني

# ── Email (Resend — FREE 3000 emails/month) ───────────────
# Get key from: resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx

# ── Delivery ──────────────────────────────────────────────
DEFAULT_DELIVERY_PROVIDER=yalidine
YALIDINE_API_ID=your_api_id
YALIDINE_API_TOKEN=your_api_token
YALIDINE_FROM_WILAYA=16
ZREXPRESS_TOKEN=your_token
ZREXPRESS_KEY=your_key
MAYSTRO_TOKEN=your_token

# ── Payment (Chargily) ────────────────────────────────────
CHARGILY_SECRET_KEY=your_secret_key
NEXT_PUBLIC_CHARGILY_MODE=test

# ── AI ────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Sheets service account (server-side only) ──────
# ONE service account for all merchants. Merchants add the EMAIL as Editor
# to their own sheet. Provide EITHER the two vars below, OR the full JSON.
GOOGLE_SERVICE_ACCOUNT_EMAIL=dakkani-sheets@your-project.iam.gserviceaccount.com
# Private key — keep the literal \n escapes (PEM). Never NEXT_PUBLIC_.
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Alternative: paste the whole service-account JSON instead of the two above.
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}

# ── Pixels ────────────────────────────────────────────────
META_ACCESS_TOKEN=EAAxx...
TIKTOK_ACCESS_TOKEN=your_token

# ── Notifications ─────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=123...
WHATSAPP_BUSINESS_TOKEN=EAAxx...
TWILIO_ACCOUNT_SID=ACxx...
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Image Processing ──────────────────────────────────────
REMOVEBG_API_KEY=your_key

# ── Security ──────────────────────────────────────────────
CRON_SECRET=generate_with_openssl_rand_hex_32

# ── Storage ───────────────────────────────────────────────
NEXT_PUBLIC_STORAGE_BUCKET=dakkani-uploads

# ── Build ─────────────────────────────────────────────────
NODE_OPTIONS=--max-old-space-size=8192
DISABLE_PWA=false
