{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": ["cdg1"],

  "env": {
    "DISABLE_PWA": "false",
    "NODE_OPTIONS": "--max-old-space-size=8192"
  },

  "functions": {
    "app/api/ai/agent/route.ts": { "maxDuration": 60 },
    "app/api/ai/generate-description/route.ts": { "maxDuration": 30 },
    "app/api/ai/landing/generate/route.ts": { "maxDuration": 60 },
    "app/api/ai/photo/enhance/route.ts": { "maxDuration": 60 },
    "app/api/delivery/create/route.ts": { "maxDuration": 30 },
    "app/api/webhooks/delivery/route.ts": { "maxDuration": 30 }
  },

  "crons": [
    {
      "path": "/api/cron/auto-blacklist",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/sync-delivery-status",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/process-queue",
      "schedule": "0 3 * * *"
    }
  ],

  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" }
      ]
    },
    {
      "source": "/store/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=60, stale-while-revalidate=300" }
      ]
    }
  ],

  "rewrites": [
    { "source": "/store/:slug", "destination": "/:slug" },
    { "source": "/store/:slug/product/:product", "destination": "/:slug/product/:product" },
    { "source": "/store/:slug/products", "destination": "/:slug/products" },
    { "source": "/store/:slug/checkout", "destination": "/:slug/checkout" },
    { "source": "/store/:slug/order-confirmation", "destination": "/:slug/order-confirmation" },
    { "source": "/store/:storeSlug/:landingSlug", "destination": "/:storeSlug/:landingSlug" }
  ]
}
